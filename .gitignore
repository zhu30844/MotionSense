# --- C / CMake build output ---
/build/
/install/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
compile_commands.json

# --- Go agent build output ---
# Compiled agent binary (build with `go build`; it does not belong in git).
/agent/agent
# Go test/coverage artifacts.
*.test
*.out
coverage.txt

# --- Web front end (agent/web) ---
/agent/web/node_modules/
# `npm run build` output, embedded by the agent when present.
/agent/static/v2/

# --- IDE / editor ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- OS cruft ---
.DS_Store
Thumbs.db

# --- Logs / local runtime ---
*.log

# --- Luckfox SDK app build output ---
/build-sdk/
/install-sdk/

# --- Rockchip toolchain and flashing tools ---
# Provided by the Luckfox SDK checkout this tree lives in; see CMakeLists.txt.
/tools/

# --- vendor/: what scripts/sync-vendor.sh copies in ---
/vendor/*/include/
/vendor/*/lib/

# --- hardware/ ---
# STEP and STL written by hardware/enclosure/model.py.
/hardware/enclosure/out/
# KiCad per-user state and backups.
*.kicad_prl
*-backups/
fp-info-cache
*.lck
