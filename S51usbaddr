#!/bin/sh
# Gives usb0 its IP address, and the USB network the same two hardware
# addresses at every boot. S50usbdevice has just made the gadget with random
# ones, and a PC takes a new address on its end for a new network card,
# forgetting what was set up for the last. Then stays to put the gadget back
# on the bus whenever it drops off.

G=/sys/kernel/config/usb_gadget/rockchip
F=$G/functions/rndis.gs0
HWADDR=/oem/usr/bin/ms-hwaddr

[ "$1" = start ] && [ -d $F ] || exit 0
udc=$(cat $G/UDC)
[ -n "$udc" ] || udc=$(ls /sys/class/udc | head -n 1)

set_hwaddrs() {
    dev=$($HWADDR usb0) && host=$($HWADDR usb0-host) || return
    [ "$(cat $F/dev_addr)" = "$dev" ] && [ "$(cat $F/host_addr)" = "$host" ] && return

    # The addresses can only be written while no configuration uses the function.
    for l in $G/configs/*/f*; do
        case "$(readlink "$l")" in */rndis.gs0) link=$l ;; esac
    done
    [ -n "$link" ] || return

    echo none > $G/UDC
    rm "$link"
    echo "$dev" > $F/dev_addr
    echo "$host" > $F/host_addr
    ln -s $F "$link"
    # usb0 was made with the old address and keeps it unless told.
    ifconfig usb0 down
    ifconfig usb0 hw ether "$dev"
    ifconfig usb0 up
    echo "$udc" > $G/UDC
}

# The address the README sends users to; it stays over the down and up above.
ifconfig usb0 172.32.0.93 netmask 255.255.0.0
set_hwaddrs

# When the cable is plugged back in adbd reopens its endpoints, and the kernel
# takes the whole gadget off the controller for that; nothing puts it back.
while sleep 2; do
    [ -n "$(cat $G/UDC)" ] || echo "$udc" > $G/UDC
done > /dev/null 2>&1 &
