# Buildroot packages MotionSense needs in the target rootfs.
#
# This file is the declaration; it is not consumed by buildroot directly.
# The Luckfox SDK passes RK_BUILDROOT_DEFCONFIG straight to buildroot as a
# make target, so buildroot needs one complete defconfig file and has no
# fragment or BR2_EXTERNAL mechanism wired up in this SDK. Rather than leave
# the dependency buried in an SDK file far from the code that needs it,
# it is declared here and applied with:
#
#     scripts/gen-buildroot-defconfig.sh
#
# which regenerates sysdrv/tools/board/buildroot/motionsense_defconfig from
# the vendor luckfox_pico_defconfig plus these lines. Run it after editing
# this file, then rebuild.
#
# Each entry names the shared library it is expected to provide, which is
# what cmake/SystemLibs.cmake looks for in the sysroot.

BR2_PACKAGE_SQLITE=y    # libsqlite3.so.0  -> sqlite3::sqlite3
BR2_PACKAGE_CJSON=y     # libcjson.so.1    -> cjson::cjson

# ntpd is disabled. The RTC on this board is battery-backed and keeps correct
# time on its own — verified across a reboot, where the kernel set the system
# clock from it to the right second. ntpd's first sync then stepped the clock
# eight hours forward and took three minutes to come back, during which the
# recorder created a day directory under tomorrow's date. Nothing needs a
# network time source often enough to be worth that.
# BR2_PACKAGE_NTP is not set

# No Python: nothing in the image runs it, and it was the largest thing in
# the rootfs. The libraries above do not depend on it.
# BR2_PACKAGE_PYTHON3 is not set
# BR2_PACKAGE_PYTHON3_SSL is not set
# BR2_PACKAGE_PYTHON_AIOHTTP is not set
# BR2_PACKAGE_PYTHON_CLICK is not set
# BR2_PACKAGE_PYTHON_ITSDANGEROUS is not set
# BR2_PACKAGE_PYTHON_JINJA2 is not set
# BR2_PACKAGE_PYTHON_PERIPHERY is not set
# BR2_PACKAGE_PYTHON_PILLOW is not set
# BR2_PACKAGE_PYTHON_SERIAL is not set
# BR2_PACKAGE_PYTHON_SETUPTOOLS is not set
# BR2_PACKAGE_PYTHON_SMBUS_CFFI is not set
# BR2_PACKAGE_PYTHON_SPIDEV is not set
# BR2_PACKAGE_PYTHON_WERKZEUG is not set

# Evaluation-board tools nothing here uses. libv4l stays: RkLunch.sh needs its
# media-ctl, and it is what brings libiconv in.
# BR2_PACKAGE_GNUTLS is not set
# BR2_PACKAGE_IPTABLES is not set
# BR2_PACKAGE_IPTABLES_BPF_NFSYNPROXY is not set
# BR2_PACKAGE_IPTABLES_NFTABLES is not set
# BR2_PACKAGE_P7ZIP is not set
# BR2_PACKAGE_ZIP is not set
# BR2_PACKAGE_UNZIP is not set
# BR2_PACKAGE_BMON is not set
# BR2_PACKAGE_PCRE2_16 is not set
# BR2_PACKAGE_PCRE2_32 is not set
# BR2_PACKAGE_RSYNC is not set
# BR2_PACKAGE_LIBRSYNC is not set
# BR2_PACKAGE_IPERF is not set
# BR2_PACKAGE_IPERF3 is not set
# BR2_PACKAGE_BASH_LOADABLE_EXAMPLES is not set
# BR2_PACKAGE_SOCAT is not set
# BR2_PACKAGE_LRZSZ is not set
# BR2_PACKAGE_EVTEST is not set
# BR2_PACKAGE_TIME is not set
# BR2_PACKAGE_WGET is not set
# BR2_PACKAGE_LIBCURL is not set
# BR2_PACKAGE_LIBCURL_CURL is not set
# BR2_PACKAGE_LIBCURL_VERBOSE is not set
# BR2_PACKAGE_DIALOG is not set
# BR2_PACKAGE_HTOP is not set
# BR2_PACKAGE_NANO is not set

# The board is an ssh server only: no ssh, scp, sftp, ssh-add or ssh-agent.
# BR2_PACKAGE_OPENSSH_CLIENT is not set

# No bash: every script that runs on the board is written for busybox sh. A
# few helper scripts of other packages (dtdiff, gcore, xzgrep and its kin) ask
# for bash and no longer run.
# BR2_PACKAGE_BASH is not set

# busybox.fragment beside this file switches telnet off in busybox.
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(TOPDIR)/../../../../project/app/motionsense/busybox.fragment"

# root's password, "luckfox", as an MD5 hash with each $ doubled for make. The
# toolchain's uClibc has no SHA-256 crypt(), so sshd turns down a password
# hashed the way buildroot would hash it from plain text.
BR2_TARGET_GENERIC_ROOT_PASSWD="$$1$$dXmV8ZLO$$eNAQzSYOgRkYMJRdsHwLS1"

# mkfs.ubifs for the build machine. The SDK's own is statically linked, which
# fakeroot cannot reach into, so an image packed by an ordinary user had every
# file as that user's. The board config points the packing script at this one.
BR2_PACKAGE_HOST_MTD=y

# Not listed, but relied on and already enabled in the vendor defconfig:
#   BR2_PACKAGE_FREETYPE   libfreetype.so.6  -> freetype::freetype
#   libiconv arrives as a dependency of other packages

# Only reaches builds started by hand from the buildroot directory. Buildroot
# drops its own -j when MAKEFLAGS already carries one, and sysdrv/Makefile
# always passes -j$(SYSDRV_JOBS), so a build through build.sh takes its
# parallelism from that jobserver and never reads this. Debugging a package
# with a bare "make" in the buildroot tree does read it, and the vendor base
# pins it at 4. 0 means one job per CPU plus one, decided at build time.
BR2_JLEVEL=0

# Top-level parallel build. Buildroot serialises itself with .NOTPARALLEL
# unless each package gets its own target and host directory, because without
# that isolation a package can see whatever happened to be installed before it
# and the result stops being reproducible. With it on, packages build
# concurrently and a many-core host is actually used; the jobserver from
# sysdrv/Makefile's -j is what limits it.
#
# Buildroot labels this experimental: a package that depends on something it
# never declared builds fine today and fails here. Switching it on or off
# changes the build layout, so buildroot has to be rebuilt from clean.
BR2_PER_PACKAGE_DIRECTORIES=y
