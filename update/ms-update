#!/bin/sh
# Checks an update package, stores it and marks misc; recovery.sh flashes it.
# usage: ms-update [--no-reboot] <package.tar>
#        ms-update --discard      drop a failed upload

DIR=/userdata/update
PKG=$DIR/update.tar
# Where the agent puts an upload. The agent never deletes, so that is done here.
INCOMING=$DIR/incoming.tar
# Present while recovery is being rewritten, and after a power loss during it.
PENDING=$DIR/recovery-pending
BOARD_FILE=/etc/motionsense/board.json

die() {
    echo "ms-update: $*" >&2
    [ "$src" = "$INCOMING" ] && rm -f "$INCOMING"
    exit 1
}

[ "$1" = "--discard" ] && { rm -f "$INCOMING"; exit 0; }
reboot=y
[ "$1" = "--no-reboot" ] && { reboot=; shift; }
src=$1
[ -f "$src" ] || die "usage: ms-update [--no-reboot] <package.tar>"

mtd_of() { sed -n "s/^\(mtd[0-9]*\):.*\"$1\"\$/\1/p" /proc/mtd; }
misc=$(mtd_of misc)
[ -n "$misc" ] && [ -n "$(mtd_of recovery)" ] || die "this board has no misc and recovery partitions"

# Another board's images would not boot.
have=$(sed -n 's/.*"name"[^"]*"\([^"]*\)".*/\1/p' "$BOARD_FILE" 2>/dev/null)
want=$(tar -xOf "$src" manifest 2>/dev/null | sed -n 's/^board=//p')
[ -n "$want" ] || die "not an update package: no manifest"
[ "$have" = "$want" ] || die "package is for $want, this board is ${have:-unnamed}"

tar -xOf "$src" SHA256SUMS > /tmp/ms-update.sums 2>/dev/null
found=
rest=
new_recovery=
while read -r sum file; do
    part=${file%.img}
    case "$part" in
        boot|rootfs|oem) rest=y ;;
        recovery) new_recovery=$sum ;;
        *) die "package carries $file, which is never updated" ;;
    esac
    [ -n "$(mtd_of "$part")" ] || die "this board has no $part partition"
    [ "$(tar -xOf "$src" "$file" 2>/dev/null | sha256sum | cut -d' ' -f1)" = "$sum" ] \
        || die "$file is damaged"
    found=y
done < /tmp/ms-update.sums
[ -n "$found" ] || die "package is empty"

# recovery cannot rewrite itself, so it is written here, and only when it
# differs. No mark is set yet: after a power loss the board boots as before.
if [ -n "$new_recovery" ]; then
    rec=/dev/$(mtd_of recovery)
    size=$(tar -tvf "$src" recovery.img | awk '{print $3}')
    on_flash() { nanddump -q -l "$size" "$rec" 2>/dev/null | sha256sum | cut -d' ' -f1; }
    if [ "$(on_flash)" = "$new_recovery" ]; then
        echo "ms-update: recovery is current"
    else
        mkdir -p "$DIR" && touch "$PENDING" && sync || die "cannot write to $DIR"
        flash_eraseall "$rec" > /dev/null 2>&1 || die "cannot erase recovery"
        tar -xOf "$src" recovery.img | nandwrite -p "$rec" - > /dev/null || die "cannot write recovery"
        [ "$(on_flash)" = "$new_recovery" ] || die "recovery does not read back as written"
        echo "ms-update: recovery written"
    fi
    rm -f "$PENDING"
    sync
    if [ -z "$rest" ]; then
        [ "$src" = "$INCOMING" ] && rm -f "$INCOMING"
        exit 0
    fi
fi
# A mark with a half-written recovery would leave nothing to boot.
[ -e "$PENDING" ] && die "recovery was not written completely: send a package that carries recovery"

mkdir -p "$DIR"
rm -f "$DIR/tries" "$DIR/result" "$DIR/recovery.log"
# S99motionsense's count of bad boots: an update is not one of them.
[ -d /userdata/motionsense ] && echo 0 > /userdata/motionsense/boot_count
mv "$src" "$PKG" 2>/dev/null || cp "$src" "$PKG" || {
    rm -f "$PKG"
    die "cannot store the package in $DIR"
}
sync

# U-Boot reads the mark 16 KB into misc; an erased misc boots normally.
bcb=/tmp/ms-update.bcb
{
    dd if=/dev/zero bs=1024 count=16
    printf 'boot-recovery'
    dd if=/dev/zero bs=1 count=2035
} > "$bcb" 2>/dev/null
flash_eraseall "/dev/$misc" > /dev/null 2>&1 || die "cannot erase misc"
nandwrite -p "/dev/$misc" "$bcb" > /dev/null || die "cannot write misc"
sync

echo "ms-update: package stored, the next boot flashes it"
[ -n "$reboot" ] && reboot
exit 0
